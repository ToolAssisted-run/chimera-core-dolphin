  "romFile": "game",
  "deterministic": true,
  "memoryLayoutMiB": [
    256,
    16,
    64,
    256,
    2560
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The GameCube itself is small (24MB main RAM + 16MB ARAM + caches, all anonymous mmaps since the sandbox has no shared memory), but dolphin's own working set - the software rasterizer's EFB, texture and vertex machinery, DiscIO buffers - lives in the mmap arena too, which musl routes every large allocation into.",
  "video": {
    "gpuStatesSurviveTheContext": true,
    "_comment_gpuStates": "TRUE, and measured so. A state this core makes opens again in a later session: a run reopened onto one is byte-identical to a run that never stopped - System RAM, ARAM, the L1 cache, the emitted audio and every pixel - at 40, 120 and 240 frames past the load. Two things had to be true for that. The renderer rebuilds its GL objects when the calls land on a context that is not the one they came from (the bridge's GL_OP_CONTEXT_ID), and it leaves a framebuffer bound afterwards, without which the machine's first draw dereferences a null one. And the picture is presented by decoding the XFB from the machine's own memory rather than from a copy of it kept in VRAM: that copy is the crisp one, rendered at internal resolution, and it exists nowhere in a savestate, so a reopened run had only the RAM decode and drew a different picture from there on - 62% of the pixels 40 frames later, 99.7% after 240, never recovering. Presenting from RAM costs the upscaled picture and agrees with the software renderer, which is the machine's own answer. Above 1x Internal Resolution (chimera#149, by the user's decision) the picture IS the crisp copy in VRAM again, because that is the point of the setting: the machine is unchanged by where the picture comes from (measured: the RAM at field 3000 is the same either way), and a movie played from power-on is crisp throughout; right after a state load the picture may differ from a run that never stopped. At 1x, and on the software renderer, the picture still comes from the machine's memory.",
    "_comment": "buffer CAPACITY: 4x the machine's largest field (720x576), for Internal Resolution 4x on opengl-hw; the live size comes from GetVideoWidth/Height per frame, which follow the VI field being scanned out (640x480 NTSC progressive, 640x287-288 as one PAL/NTSC interlaced field). The static vsync fraction is the NTSC default; the runtime GetVsyncNumerator/Denominator exports follow the machine's actual video mode, PAL included.",
    "width": 2880,
    "height": 2304,
    "virtualWidth": 640,
    "virtualHeight": 480,
    "vsyncNumerator": 60000,
    "vsyncDenominator": 1001,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "the mixer's 48kHz stereo output, drained by machine time: rate * den / num samples per field with the remainder accumulated, so a PAL field is exactly 960 pairs and nothing is ever lost or invented.",
    "rate": 48000,
    "samplesPerFrame": 16384,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "settings": [
    {
      "name": "machine",
      "display": "Machine",
      "description": "Which machine this project is: a GameCube, a Wii, or a Triforce arcade board. The choice is saved in the project and recorded in the movie. The core never guesses it from the game file, and a game for another machine is refused. A GameCube has memory card slots, and a Wii keeps its saves in its internal memory (NAND). 'triforce' is the arcade board that Sega, Namco and Nintendo built from GameCube hardware (Virtua Striker, F-Zero AX, Mario Kart Arcade GP). A Triforce disc image is marked as such, and the project must say 'triforce' to start one.",
      "type": "enum",
      "options": [
        "gamecube",
        "wii",
        "triforce"
      ],
      "default": "gamecube"
    },
    {
      "name": "port1",
      "display": "Controller in Port 1",
      "type": "enum",
      "options": [
        "none",
        "gc-controller"
      ],
      "default": "gc-controller",
      "description": "What is plugged into controller port 1. With the port empty, games find nothing connected there, as on a real console, and some games behave differently. The port's buttons and sticks are then also removed from the input columns and from the movie.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "gamecube",
          "wii"
        ]
      }
    },
    {
      "name": "port2",
      "display": "Controller in Port 2",
      "type": "enum",
      "options": [
        "none",
        "gc-controller"
      ],
      "default": "none",
      "description": "What is plugged into controller port 2. With the port empty, games find nothing connected there, as on a real console, and some games behave differently. The port's buttons and sticks are then also removed from the input columns and from the movie.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "gamecube",
          "wii"
        ]
      }
    },
    {
      "name": "port3",
      "display": "Controller in Port 3",
      "type": "enum",
      "options": [
        "none",
        "gc-controller"
      ],
      "default": "none",
      "description": "What is plugged into controller port 3. With the port empty, games find nothing connected there, as on a real console, and some games behave differently. The port's buttons and sticks are then also removed from the input columns and from the movie.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "gamecube",
          "wii"
        ]
      }
    },
    {
      "name": "port4",
      "display": "Controller in Port 4",
      "type": "enum",
      "options": [
        "none",
        "gc-controller"
      ],
      "default": "none",
      "description": "What is plugged into controller port 4. With the port empty, games find nothing connected there, as on a real console, and some games behave differently. The port's buttons and sticks are then also removed from the input columns and from the movie.",
      "exposedWhen": {
        "setting": "machine",
        "in": [
          "gamecube",
          "wii"
        ]
      }
    },
    {
      "name": "memcard_a",
      "display": "Memory Card in Slot A",
      "type": "bool",
      "default": true,
      "description": "Whether a memory card is in the first slot. Games check for a card on their first screen and behave differently without one, so this is part of the machine. The card's contents are not chosen here. They come from the project's save data and go back to it.",
      "exposedWhen": {
        "setting": "machine",
        "is": "gamecube"
      }
    },
    {
      "name": "triforce_segaboot",
      "display": "Triforce: SegaBoot Firmware",
      "type": "bool",
      "default": false,
      "description": "Gives the arcade cabinet its own firmware, SegaBoot. The cabinet's TEST switch opens a menu in this firmware, and without it the switch does nothing. Most games never need it. Mario Kart Arcade GP is the exception. It stops at CAMERA ERROR because there is no camera here, and the camera is turned off in the test menu. The firmware is a file you supply (segaboot.gcm, 2 MiB). Whether the cabinet has it is part of the machine, so a movie needs the same choice.",
      "exposedWhen": {
        "setting": "machine",
        "is": "triforce"
      }
    },
    {
      "name": "widescreen",
      "display": "Widescreen (Wii)",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "machine",
        "is": "wii"
      },
      "description": "The Wii's own system setting 'Screen: Widescreen'. A Wii game reads it to decide whether to draw for a 16:9 or a 4:3 screen, and many games draw differently for each, so it is part of the machine and a movie records it. Off means 4:3, which is what a new console is set to. The picture Chimera shows stays 640 pixels wide in both cases. To see a widescreen game in its intended shape, set Config > Display > Aspect Ratio Selection > 'Use custom AR' to 16:9."
    },
    {
      "name": "cpu_core",
      "display": "CPU Emulation",
      "type": "enum",
      "options": [
        "interpreter",
        "cached-interpreter",
        "jit"
      ],
      "default": "jit",
      "description": "How the console's PowerPC processor is emulated. Each of the three choices gives the same result on every run and on every computer. They do NOT give the same result as each other. The cached interpreter and the JIT count time in blocks of instructions, and the interpreter counts every instruction, so the machine's timing differs and a movie made with one does not play back with another. 'jit' translates PowerPC code into your computer's own code and is the default because it is about five times faster. 'cached-interpreter' groups instructions into prepared blocks. 'interpreter' is the slowest and the most thoroughly tested."
    },
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "software",
        "opengl-hw"
      ],
      "default": "opengl-hw",
      "description": "Which renderer draws the picture. 'software' is Dolphin's software renderer. It runs completely inside the sandbox and gives the same picture on every computer, so choose it when a movie must play back on computers different from yours. 'opengl-hw' is Dolphin's OpenGL renderer drawing on your REAL graphics card through the bridge. It is much faster and looks best. The graphics card is outside the sandbox and differs between computers, and parts of the picture are copied back into the console's memory, so a movie recorded this way plays back only on the same graphics driver. On a computer with no usable graphics card the core draws in software and says so."
    },
    {
      "name": "mmu",
      "display": "Enable MMU",
      "type": "bool",
      "default": false,
      "description": "Dolphin's full memory-management emulation (Config > Advanced > Enable MMU). A few games need it to run correctly, and TASVideos requires it for those. Off is Dolphin's default. On is slower. It changes how the processor behaves, with either renderer, so a movie records it and needs the same value to play back."
    },
    {
      "name": "internal_resolution",
      "display": "Internal Resolution",
      "type": "enum",
      "options": [
        "1x",
        "2x",
        "3x",
        "4x"
      ],
      "default": "1x",
      "exposedWhen": {
        "setting": "renderer",
        "is": "opengl-hw"
      },
      "description": "How many times the console's resolution the graphics card draws at (Graphics > Enhancements > Internal Resolution). Above 1x the picture Chimera shows and records is the sharper one the graphics card drew. For example a 640x448 game at 2x is 1280x896. It can change how the game runs and not only how it looks, because games read parts of their own picture back into the console's memory. A movie made with one value may not play back with another, so choose it when you create the project. Measured on Virtua Striker 2002, 2x changes the console's memory from the first 3D frame on, and the number of lag frames after 3000 fields is 547 against 585 at 1x. One limit: the sharper picture is not part of a savestate, so right after a state is loaded the picture can look different from a run that never stopped. The game itself is not affected, and a movie played from the start is sharp throughout."
    },
    {
      "name": "msaa",
      "display": "Anti-Aliasing (MSAA)",
      "type": "enum",
      "options": [
        "off",
        "2x",
        "4x",
        "8x"
      ],
      "default": "off",
      "exposedWhen": {
        "setting": "renderer",
        "is": "opengl-hw"
      },
      "description": "Multisample anti-aliasing (Graphics > Enhancements > Anti-Aliasing). It smooths the edges of what the graphics card draws. It can change how the game runs and not only how it looks, because games read parts of their own picture back into the console's memory. A movie made with one value may not play back with another, so choose it when you create the project."
    },
    {
      "name": "ssaa",
      "display": "Supersampling (SSAA)",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "renderer",
        "is": "opengl-hw"
      },
      "description": "Turns the anti-aliasing above into supersampling, which also smooths the inside of textures and effects and costs more graphics time. It does nothing while Anti-Aliasing is off. It can change how the game runs and not only how it looks, because games read parts of their own picture back into the console's memory. A movie made with one value may not play back with another, so choose it when you create the project."
    },
    {
      "name": "anisotropy",
      "display": "Anisotropic Filtering",
      "type": "enum",
      "options": [
        "default",
        "1x",
        "2x",
        "4x",
        "8x",
        "16x"
      ],
      "default": "default",
      "exposedWhen": {
        "setting": "renderer",
        "is": "opengl-hw"
      },
      "description": "Anisotropic texture filtering (Graphics > Enhancements). It makes textures seen at a flat angle sharper. 'default' leaves each texture as the game set it. It can change how the game runs and not only how it looks, because games read parts of their own picture back into the console's memory. A movie made with one value may not play back with another, so choose it when you create the project."
    },
    {
      "name": "texture_filtering",
      "display": "Texture Filtering",
      "type": "enum",
      "options": [
        "default",
        "nearest",
        "linear"
      ],
      "default": "default",
      "exposedWhen": {
        "setting": "renderer",
        "is": "opengl-hw"
      },
      "description": "Forces every texture to be drawn either blocky (nearest) or smoothed (linear) (Graphics > Enhancements > Texture Filtering). 'default' leaves each texture as the game set it. It can change how the game runs and not only how it looks, because games read parts of their own picture back into the console's memory. A movie made with one value may not play back with another, so choose it when you create the project."
    },
    {
      "name": "widescreen_hack",
      "display": "Widescreen Hack",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "renderer",
        "is": "opengl-hw"
      },
      "description": "Dolphin's widescreen hack (Graphics > General). The game's 3D view is widened to fill a 16:9 screen. The picture keeps the console's own width, so it looks squeezed until you set Config > Display > Aspect Ratio to 16:9. The 2D parts of a game (menus, status displays) are not widened and may look stretched. It can change how the game runs and not only how it looks, because games read parts of their own picture back into the console's memory. A movie made with one value may not play back with another, so choose it when you create the project."
    },
    {
      "name": "texture_cache",
      "display": "Texture Cache Accuracy",
      "type": "enum",
      "options": [
        "safe",
        "medium",
        "fast"
      ],
      "default": "fast",
      "exposedWhen": {
        "setting": "renderer",
        "is": "opengl-hw"
      },
      "description": "How carefully Dolphin checks whether a texture in the game's memory has changed (Graphics > Hacks > Texture Cache Accuracy). 'safe' checks the whole texture and notices games that change one in place. 'fast' is Dolphin's default. No difference was seen in the games tried here (up to 3000 fields, including 3D scenes). Where a game does change textures in place, 'safe' draws it correctly and the others may not. It can change how the game runs and not only how it looks, because games read parts of their own picture back into the console's memory. A movie made with one value may not play back with another, so choose it when you create the project."
    },
    {
      "name": "gpu_texture_decoding",
      "display": "GPU Texture Decoding",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "renderer",
        "is": "opengl-hw"
      },
      "description": "Decodes textures on the graphics card instead of the processor (Graphics > Hacks). It is meant to be faster. No difference in the picture or in the game was seen in the games tried here. Off is Dolphin's default."
    }
  ],
  "firmware": [
    {
      "id": "segaboot.gcm",
      "display": "Triforce SegaBoot",
      "description": "The Triforce's own firmware. It is the program the arcade board starts from, and the cabinet's TEST switch opens a menu in it. The file is a 2 MiB image whose header reads RELSAB / SegaBoot. It is asked for only when 'Triforce: SegaBoot Firmware' is on.",
      "name": "segaboot.gcm",
      "size": 2097152,
      "requiredWhen": {
        "all": [
          { "setting": "machine", "is": "triforce" },
          { "setting": "triforce_segaboot", "is": true }
        ]
      }
    }
  ]
}
