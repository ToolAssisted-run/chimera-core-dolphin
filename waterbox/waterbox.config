{
  "coreName": "Dolphin",
  "systemId": "GC",
  "author": "the Dolphin Team",
  "url": "https://github.com/dolphin-emu/dolphin",
  "romFile": "game",
  "deterministic": true,
  "memoryLayoutMiB": [
    256,
    16,
    64,
    256,
    2560
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The GameCube itself is small (24MB main RAM + 16MB ARAM + caches, all anonymous mmaps since the sandbox has no shared memory), but dolphin's own working set - the software rasterizer's EFB, texture and vertex machinery, DiscIO buffers - lives in the mmap arena too, which musl routes every large allocation into.",
  "video": {
    "_comment": "buffer CAPACITY; the live size comes from GetVideoWidth/Height per frame, which follow the VI field being scanned out (640x480 NTSC progressive, 640x287-288 as one PAL/NTSC interlaced field). The static vsync fraction is the NTSC default; the runtime GetVsyncNumerator/Denominator exports follow the machine's actual video mode, PAL included.",
    "width": 720,
    "height": 574,
    "virtualWidth": 640,
    "virtualHeight": 480,
    "vsyncNumerator": 60000,
    "vsyncDenominator": 1001,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "the mixer's 48kHz stereo output, drained by machine time: rate * den / num samples per field with the remainder accumulated, so a PAL field is exactly 960 pairs and nothing is ever lost or invented.",
    "samplesPerFrame": 16384,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".iso": "GC",
    ".gcm": "GC",
    ".rvz": "GC",
    ".dol": "GC",
    ".elf": "GC"
  },
  "input": {
    "name": "GameCube Controller",
    "_comment": "Four controller ports, each the pad a GameCube ships with. Wire order per pad: A B X Y Z Start Up Down Left Right L R, then Main Stick X/Y, C-Stick X/Y and the two analog trigger travels. The digital L/R bits are the full-press clicks at the bottom of the trigger travel; pressing them reports full analog travel too, the way the real trigger cannot click without being down.",
    "buttons": [
      "P1 A", "P1 B", "P1 X", "P1 Y", "P1 Z", "P1 Start", "P1 Up", "P1 Down", "P1 Left", "P1 Right", "P1 L", "P1 R",
      "P2 A", "P2 B", "P2 X", "P2 Y", "P2 Z", "P2 Start", "P2 Up", "P2 Down", "P2 Left", "P2 Right", "P2 L", "P2 R",
      "P3 A", "P3 B", "P3 X", "P3 Y", "P3 Z", "P3 Start", "P3 Up", "P3 Down", "P3 Left", "P3 Right", "P3 L", "P3 R",
      "P4 A", "P4 B", "P4 X", "P4 Y", "P4 Z", "P4 Start", "P4 Up", "P4 Down", "P4 Left", "P4 Right", "P4 L", "P4 R"
    ],
    "axes": [
      { "name": "P1 Main Stick X", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P1 Main Stick Y", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P1 C-Stick X", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P1 C-Stick Y", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P1 Trigger L", "min": 0, "max": 255, "neutral": 0 },
      { "name": "P1 Trigger R", "min": 0, "max": 255, "neutral": 0 },
      { "name": "P2 Main Stick X", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P2 Main Stick Y", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P2 C-Stick X", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P2 C-Stick Y", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P2 Trigger L", "min": 0, "max": 255, "neutral": 0 },
      { "name": "P2 Trigger R", "min": 0, "max": 255, "neutral": 0 },
      { "name": "P3 Main Stick X", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P3 Main Stick Y", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P3 C-Stick X", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P3 C-Stick Y", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P3 Trigger L", "min": 0, "max": 255, "neutral": 0 },
      { "name": "P3 Trigger R", "min": 0, "max": 255, "neutral": 0 },
      { "name": "P4 Main Stick X", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P4 Main Stick Y", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P4 C-Stick X", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P4 C-Stick Y", "min": -128, "max": 127, "neutral": 0 },
      { "name": "P4 Trigger L", "min": 0, "max": 255, "neutral": 0 },
      { "name": "P4 Trigger R", "min": 0, "max": 255, "neutral": 0 }
    ]
  },
  "settings": [
    {
      "name": "memcard_a",
      "display": "Memory Card in Slot A",
      "type": "bool",
      "default": true,
      "description": "Whether the machine has a card in its first slot. Games ask on their first screen and behave differently without one, so this is part of the machine. The card itself is not a file here: it arrives from, and returns to, the project's save data."
    }
  ]
}
