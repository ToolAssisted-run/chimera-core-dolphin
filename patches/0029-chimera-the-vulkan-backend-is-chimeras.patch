+// ---------------------------------------------------------------------------
+// chimera: A SAVESTATE LOADED INTO CHIMERA IS A NEW VULKAN DEVICE.
+//
+// The frontend destroys its device at every load and makes another (miniBox
+// source/vk); a handle from before the load is refused there. So this backend
+// makes everything again - the device, and every object the shared video code
+// made on it - as the OpenGL backend does for a context that moved
+// (OGLGfx.cpp, ChimeraRebuildGLObjects; chimera issues 43, 126 and 190).
+//
+// Two halves, and the order within the first matters. While the old objects
+// are let go of, nothing crosses to the frontend (chimera_dolphin_vulkan_quiet:
+// they are gone there already). The shared code's objects go FIRST: their
+// destructors hand the handles to the command buffer manager to destroy later,
+// and that has to be the old manager, which is dropped next with the rest of
+// the old device. Then commands cross again, and everything is made.
+//
+// What is kept is what the machine knows: the texture cache's entries for EFB
+// and XFB copies, the vertex loaders, the shader UIDs. What a state carried of
+// the card's contents is given back at the end (ChimeraRestoreShadow, below).
+// ---------------------------------------------------------------------------
+void ChimeraDropDevice();
+bool ChimeraMakeDevice();
 }  // namespace Vulkan
+
+extern "C" uint64_t chimera_dolphin_vulkan_context(void) __attribute__((weak));
+extern "C" void chimera_dolphin_vulkan_quiet(void) __attribute__((weak));
+extern "C" void chimera_dolphin_vulkan_old_device_gone(void) __attribute__((weak));
+
+namespace
+{
+// set after a load (StateLoaded), read and cleared at the head of the next frame
+bool s_chimera_state_loaded = false;
+// the device this backend's objects were made on. In emulated memory, so a load
+// brings back the value the state was made under - which is the point.
+uint64_t s_chimera_saved_context = 0;
+
+// THE FRAME BEING DRAWN AND THE TEXTURE CACHE'S COPIES ARE ON THE CARD AND
+// NOWHERE ELSE (chimera issue 190). The same table the OpenGL backend keeps,
+// in the same two blocks (the driver hands them to both): written before a
+// state is taken, read after a load. See OGLGfx.cpp for why each kind is here.
+constexpr u64 CHIMERA_SHADOW_MAGIC = 0x3257444853584843ull;
+constexpr u32 CHIMERA_SHADOW_MAX_RECORDS = 1024;
+
+enum : u32
+{
+  CHIMERA_EFB_COLOR = 1,
+  CHIMERA_EFB_DEPTH = 2,  // as the colour ResolveEFBDepthTexture makes of it
+  CHIMERA_CACHE_COPY = 3,
+  CHIMERA_PENDING_COPY = 4,
+};
+
+struct ChimeraShadowHeader
+{
+  u64 magic;
+  u32 count;
+  u32 unused;
+  u64 end;  // bytes of pixels in use
+};
+
+struct ChimeraShadowRecord
+{
+  u64 owner;  // the TCacheEntry, for the two kinds that have one
+  u64 offset;
+  u64 bytes;
+  u32 kind;
+  u32 width;
+  u32 height;
+  u32 flags;  // the texture's AbstractTextureFlag bits
+};
+
+constexpr size_t CHIMERA_SHADOW_TABLE_BYTES =
+    sizeof(ChimeraShadowHeader) + CHIMERA_SHADOW_MAX_RECORDS * sizeof(ChimeraShadowRecord);
+
+u8* s_chimera_block = nullptr;
+size_t s_chimera_block_bytes = 0;
+u8* s_chimera_scratch = nullptr;
+size_t s_chimera_scratch_bytes = 0;
+// the block holds this device's frame (set by a save, cleared by the next frame)
+bool s_chimera_current = false;
+// what the last load brought is usable (worked out after the load)
+bool s_chimera_usable = false;
+
+ChimeraShadowHeader* ChimeraHeader()
+{
+  return reinterpret_cast<ChimeraShadowHeader*>(s_chimera_block);
+}
+ChimeraShadowRecord* ChimeraRecords()
+{
+  return reinterpret_cast<ChimeraShadowRecord*>(s_chimera_block + sizeof(ChimeraShadowHeader));
+}
+u8* ChimeraPixels()
+{
+  return s_chimera_block + CHIMERA_SHADOW_TABLE_BYTES;
+}
+size_t ChimeraPixelBytes()
+{
+  return s_chimera_block_bytes - CHIMERA_SHADOW_TABLE_BYTES;
+}
+u8* ChimeraBand()
+{
+  return s_chimera_scratch + CHIMERA_SHADOW_TABLE_BYTES;
+}
+size_t ChimeraBandBytes()
+{
+  return s_chimera_scratch_bytes - CHIMERA_SHADOW_TABLE_BYTES;
+}
+
+// One texture to read through for each size and format met, kept between
+// states: making one is a buffer made on the card, at every state otherwise.
+struct ChimeraReader
+{
+  u32 width, height;
+  AbstractTextureFormat format;
+  std::unique_ptr<AbstractStagingTexture> staging;
+};
+std::vector<ChimeraReader> s_chimera_readers;
+
+AbstractStagingTexture* ChimeraReaderFor(u32 width, u32 height, AbstractTextureFormat format)
+{
+  for (ChimeraReader& reader : s_chimera_readers)
+  {
+    if (reader.width == width && reader.height == height && reader.format == format)
+      return reader.staging.get();
+  }
+  if (s_chimera_readers.size() >= 16)
+    s_chimera_readers.erase(s_chimera_readers.begin());
+  auto staging = g_gfx->CreateStagingTexture(
+      StagingTextureType::Readback,
+      TextureConfig(width, height, 1, 1, 1, format, 0, AbstractTextureType::Texture_2DArray));
+  if (!staging)
+    return nullptr;
+  s_chimera_readers.push_back({width, height, format, std::move(staging)});
+  return s_chimera_readers.back().staging.get();
+}
+
+// A texture's pixels (four bytes each) into the block at `at`, a band of rows
+// at a time through the scratch block, and written only where they differ: an
+// unchanged surface then costs the next state nothing.
+bool ChimeraReadTexture(AbstractTexture* texture, u32 width, u32 height, u8* at)
+{
+  AbstractStagingTexture* const staging = ChimeraReaderFor(width, height, texture->GetFormat());
+  if (!staging)
+    return false;
+  const MathUtil::Rectangle<int> whole(0, 0, int(width), int(height));
+  staging->CopyFromTexture(texture, whole, 0, 0, whole);
+  staging->Flush();
+  if (!staging->Map())
+    return false;
+  const size_t row_bytes = size_t(width) * 4;
+  const u32 band = std::max<u32>(1, u32(ChimeraBandBytes() / row_bytes));
+  for (u32 y = 0; y < height; y += band)
+  {
+    const u32 rows = std::min(band, height - y);
+    const size_t bytes = row_bytes * rows;
+    staging->ReadTexels(MathUtil::Rectangle<int>(0, int(y), int(width), int(y + rows)),
+                        ChimeraBand(), u32(row_bytes));
+    u8* const dst = at + size_t(y) * row_bytes;
+    if (std::memcmp(dst, ChimeraBand(), bytes) != 0)
+      std::memcpy(dst, ChimeraBand(), bytes);
+  }
+  staging->Unmap();
+  return true;
+}
+
+const ChimeraShadowRecord* ChimeraFind(u32 kind, u64 owner)
+{
+  const ChimeraShadowHeader* const header = ChimeraHeader();
+  const ChimeraShadowRecord* const records = ChimeraRecords();
+  for (u32 i = 0; i < header->count; i++)
+  {
+    if (records[i].kind == kind && records[i].owner == owner)
+      return &records[i];
+  }
+  return nullptr;
+}
+
+bool ChimeraShadowUsable()
+{
+  return s_chimera_block && ChimeraHeader()->magic == CHIMERA_SHADOW_MAGIC &&
+         ChimeraHeader()->count <= CHIMERA_SHADOW_MAX_RECORDS;
+}
+
+bool ChimeraCarriable(const AbstractTexture* texture)
+{
+  return texture && !texture->IsMultisampled() && texture->GetLayers() == 1 &&
+         texture->GetLevels() == 1 && texture->GetFormat() == AbstractTextureFormat::RGBA8 &&
+         texture->GetWidth() > 0 && texture->GetHeight() > 0;
+}
+
+bool ChimeraWanted(const TCacheEntry* entry)
+{
+  if (entry->is_xfb_copy || entry->is_xfb_container)
+    return !g_ActiveConfig.bChimeraXfbFromRamOnly;
+  return entry->is_efb_copy;
+}
+
+void ChimeraLetGoOfTextureCache(bool keep)
+{
+  if (!g_texture_cache)
+    return;
+  if (!keep || !ChimeraShadowUsable())
+  {
+    g_texture_cache->ChimeraLetGo(nullptr, nullptr);
+    return;
+  }
+  g_texture_cache->ChimeraLetGo(
+      [](TCacheEntry* entry) {
+        return ChimeraFind(CHIMERA_CACHE_COPY, reinterpret_cast<u64>(entry)) != nullptr;
+      },
+      [](TCacheEntry* entry) {
+        return ChimeraFind(CHIMERA_PENDING_COPY, reinterpret_cast<u64>(entry)) != nullptr;
+      });
+}
+
+// a texture made of bytes the block carried, to draw or to seat
+std::unique_ptr<AbstractTexture> ChimeraTextureOf(const ChimeraShadowRecord& rec,
+                                                  AbstractTextureFormat format)
+{
+  auto texture = g_gfx->CreateTexture(TextureConfig(rec.width, rec.height, 1, 1, 1, format, 0,
+                                                    AbstractTextureType::Texture_2DArray),
+                                      "chimera: carried by a state");
+  if (texture)
+    texture->Load(0, rec.width, rec.height, rec.width, ChimeraPixels() + rec.offset,
+                  size_t(rec.bytes));
+  return texture;
+}
+
+void ChimeraRestoreShadow()
+{
+  if (!ChimeraShadowUsable() || !g_framebuffer_manager || !g_texture_cache)
+    return;
+  u8* const pixels = ChimeraPixels();
+  const auto fits = [](const ChimeraShadowRecord* rec) {
+    return rec && rec->bytes == u64(rec->width) * rec->height * 4 &&
+           rec->offset + rec->bytes <= ChimeraPixelBytes();
+  };
+
+  // The EFB, both or neither: two textures made of the bytes, drawn over it
+  // the way upstream's own savestates give an EFB back (DoLoadState).
+  AbstractTexture* const color = g_framebuffer_manager->GetEFBColorTexture();
+  AbstractTexture* const depth = g_framebuffer_manager->GetEFBDepthTexture();
+  const ChimeraShadowRecord* const color_rec = ChimeraFind(CHIMERA_EFB_COLOR, 0);
+  const ChimeraShadowRecord* const depth_rec = ChimeraFind(CHIMERA_EFB_DEPTH, 0);
+  if (fits(color_rec) && fits(depth_rec) && color && depth && !color->IsMultisampled() &&
+      color->GetLayers() == 1 && color->GetWidth() == color_rec->width &&
+      color->GetHeight() == color_rec->height && depth_rec->width == color_rec->width &&
+      depth_rec->height == color_rec->height)
+  {
+    auto color_copy = ChimeraTextureOf(*color_rec, FramebufferManager::GetEFBColorFormat());
+    auto depth_copy = ChimeraTextureOf(*depth_rec, FramebufferManager::GetEFBDepthCopyFormat());
+    if (color_copy && depth_copy)
+      g_framebuffer_manager->ChimeraRestoreEFB(color_copy.get(), depth_copy.get());
+  }
+
+  // The texture cache's copies: a new texture for each entry that was kept.
+  std::vector<TCacheEntry*> lost;
+  const ChimeraShadowHeader* const header = ChimeraHeader();
+  const ChimeraShadowRecord* const records = ChimeraRecords();
+  for (u32 i = 0; i < header->count; i++)
+  {
+    const ChimeraShadowRecord& rec = records[i];
+    TCacheEntry* const entry = reinterpret_cast<TCacheEntry*>(rec.owner);
+    if (rec.kind == CHIMERA_CACHE_COPY)
+    {
+      bool ok = false;
+      if (fits(&rec))
+      {
+        const TextureConfig config(rec.width, rec.height, 1, 1, 1, AbstractTextureFormat::RGBA8,
+                                   rec.flags, AbstractTextureType::Texture_2DArray);
+        if (g_texture_cache->ChimeraReseat(entry, config))
+        {
+          entry->texture->Load(0, rec.width, rec.height, rec.width, pixels + rec.offset,
+                               size_t(rec.bytes));
+          ok = true;
+        }
+      }
+      if (!ok)
+        lost.push_back(entry);
+    }
+    else if (rec.kind == CHIMERA_PENDING_COPY)
+    {
+      if (rec.offset + rec.bytes > ChimeraPixelBytes() ||
+          !g_texture_cache->ChimeraReseatPending(entry, pixels + rec.offset, size_t(rec.bytes)))
+      {
+        lost.push_back(entry);
+      }
+    }
+  }
+  for (TCacheEntry* entry : lost)
+    g_texture_cache->ChimeraDrop(entry);
+
+  // drawing over the EFB left the renderer on its own state; back to the machine's
+  g_framebuffer_manager->BindEFBFramebuffer();
+  BPFunctions::SetScissorAndViewport(g_framebuffer_manager.get(), bpmem.scissorTL,
+                                     bpmem.scissorBR, bpmem.scissorOffset, xfmem.viewport);
+}
+}  // namespace
