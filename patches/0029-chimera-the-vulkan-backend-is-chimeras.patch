+namespace Vulkan
+{
+void VKGfx::ChimeraRebuild(bool keep)
+{
+  // ---- let go, with nothing crossing ----
+  if (&chimera_dolphin_vulkan_quiet)
+    chimera_dolphin_vulkan_quiet();
+
+  s_chimera_readers.clear();
+  ChimeraLetGoOfTextureCache(keep);
+  g_texture_cache->ChimeraUtilityTextures(false);
+  // (the shader cache before the EFB: it finishes the pipelines it had queued
+  // on the way, and those ask the EFB what they draw into)
+  g_shader_cache->ChimeraClearCaches();
+  g_framebuffer_manager->ChimeraDestroyDeviceObjects();
+  VertexManager* const vertex_manager = static_cast<VertexManager*>(g_vertex_manager.get());
+  vertex_manager->ChimeraDropDeviceObjects();
+  if (g_backend_info.bSupportsBBox)
+    static_cast<VKBoundingBox*>(g_bounding_box.get())->ChimeraDropDeviceObjects();
+  g_perf_query.reset();
+  m_current_framebuffer = nullptr;
+  ChimeraDropDevice();
+
+  if (&chimera_dolphin_vulkan_old_device_gone)
+    chimera_dolphin_vulkan_old_device_gone();
+
+  // ---- make, on the device there is now ----
+  if (!ChimeraMakeDevice())
+  {
+    PanicAlertFmt("chimera: the Vulkan device could not be made again after a savestate was loaded");
+    return;
+  }
+  for (SamplerState& sampler_state : m_sampler_states)
+    sampler_state = RenderState::GetPointSamplerState();
+
+  if (!vertex_manager->ChimeraMakeDeviceObjects())
+    PanicAlertFmt("chimera: the stream buffers could not be made again");
+  g_perf_query = std::make_unique<PerfQuery>();
+  if (!g_perf_query->Initialize())
+    PanicAlertFmt("chimera: the query pool could not be made again");
+  if (g_backend_info.bSupportsBBox && !g_bounding_box->Initialize())
+    PanicAlertFmt("chimera: the bounding box buffer could not be made again");
+  // The order is start-up's. The EFB's framebuffers first: the shader cache's
+  // pipelines are made for what they draw into. Then every shader and pipeline
+  // of the shader cache - the vertex manager keeps the pipeline it last drew
+  // with until its configuration changes, so it is told. Then the EFB's own
+  // pipelines, which are built from the shader cache's shaders.
+  if (!g_texture_cache->ChimeraUtilityTextures(true))
+    PanicAlertFmt("chimera: the texture cache's own textures could not be made again");
+  if (!g_framebuffer_manager->ChimeraCreateDeviceObjects(g_ActiveConfig.iEFBScale))
+    PanicAlertFmt("chimera: the EFB could not be made again");
+  g_vertex_manager->InvalidatePipelineObject();
+  g_shader_cache->Reload();
+  g_framebuffer_manager->RecompileShaders();
+
+  // The machine draws through BPFunctions::SetScissorAndViewport as soon as it
+  // runs again, and that asks for the current framebuffer without checking.
+  g_framebuffer_manager->BindEFBFramebuffer();
+
+  if (keep)
+    ChimeraRestoreShadow();
+}
+}  // namespace Vulkan
+
+// chimera: where the copy goes, given once during Init (the driver hands the
+// OpenGL backend the same two blocks; only one backend runs)
+extern "C" void chimera_dolphin_vk_efb_blocks(void* block, size_t block_bytes, void* scratch,
+                                              size_t scratch_bytes)
+{
+  s_chimera_block = static_cast<u8*>(block);
+  s_chimera_block_bytes = block_bytes;
+  s_chimera_scratch = static_cast<u8*>(scratch);
+  s_chimera_scratch_bytes = scratch_bytes;
+}
+
+// chimera: told after every load of the machine, before it runs again
+extern "C" void chimera_dolphin_vk_state_loaded(void)
+{
+  s_chimera_state_loaded = true;
+  s_chimera_usable = s_chimera_current;
+}
+
+// chimera: told before a state is taken, the machine stopped at a field's end
+extern "C" void chimera_dolphin_vk_state_saving(void)
+{
+  if (!s_chimera_block || !s_chimera_scratch || !(&chimera_dolphin_vulkan_context) ||
+      !g_framebuffer_manager || !g_vertex_manager || !g_texture_cache ||
+      s_chimera_block_bytes <= CHIMERA_SHADOW_TABLE_BYTES ||
+      s_chimera_scratch_bytes <= CHIMERA_SHADOW_TABLE_BYTES)
+    return;
+  // Another device than the objects': a state taken after a load and before
+  // the next frame. The handles here are nobody's, and the copy the load
+  // brought is still the card.
+  const uint64_t live = chimera_dolphin_vulkan_context();
+  if (live == 0 || live != s_chimera_saved_context)
+    return;
+
+  g_vertex_manager->Flush();
+  g_framebuffer_manager->FlushEFBPokes();
+
+  ChimeraShadowRecord* const fresh = reinterpret_cast<ChimeraShadowRecord*>(s_chimera_scratch);
+  u8* const pixels = ChimeraPixels();
+  u32 count = 0;
+  u64 end = 0;
+  // a texture's pixels, as a record; false when there is no room or no read
+  const auto add_texture = [&](u32 kind, u64 owner, AbstractTexture* texture) {
+    if (count == CHIMERA_SHADOW_MAX_RECORDS)
+      return false;
+    const u32 width = texture->GetWidth(), height = texture->GetHeight();
+    const u64 bytes = u64(width) * height * 4;
+    if (end + bytes > ChimeraPixelBytes() || size_t(width) * 4 > ChimeraBandBytes())
+      return false;
+    if (!ChimeraReadTexture(texture, width, height, pixels + end))
+      return false;
+    ChimeraShadowRecord rec = {};
+    rec.owner = owner;
+    rec.offset = end;
+    rec.bytes = bytes;
+    rec.kind = kind;
+    rec.width = width;
+    rec.height = height;
+    rec.flags = texture->GetConfig().flags;
+    fresh[count++] = rec;
+    end += bytes;
+    return true;
+  };
+
+  // The EFB: both textures or neither. A Vulkan depth texture is not read as
+  // one; ResolveEFBDepthTexture draws it into a colour of the same 32 bits,
+  // which is what upstream's own savestates keep.
+  AbstractTexture* const color = g_framebuffer_manager->GetEFBColorTexture();
+  AbstractTexture* const depth = g_framebuffer_manager->GetEFBDepthTexture();
+  if (color && depth && !color->IsMultisampled() && color->GetLayers() == 1 &&
+      color->GetFormat() == AbstractTextureFormat::RGBA8 && color->GetWidth() > 0 &&
+      color->GetHeight() > 0 &&
+      AbstractTexture::GetTexelSizeForFormat(FramebufferManager::GetEFBDepthCopyFormat()) == 4)
+  {
+    AbstractTexture* const depth_as_color =
+        g_framebuffer_manager->ResolveEFBDepthTexture(depth->GetRect(), true);
+    if (!depth_as_color || depth_as_color->GetWidth() != color->GetWidth() ||
+        depth_as_color->GetHeight() != color->GetHeight() ||
+        !add_texture(CHIMERA_EFB_COLOR, 0, color) ||
+        !add_texture(CHIMERA_EFB_DEPTH, 0, depth_as_color))
+    {
+      count = 0;
+      end = 0;
+    }
+    // the resolve drew; back to where the machine left the renderer
+    g_framebuffer_manager->BindEFBFramebuffer();
+    BPFunctions::SetScissorAndViewport(g_framebuffer_manager.get(), bpmem.scissorTL,
+                                     bpmem.scissorBR, bpmem.scissorOffset, xfmem.viewport);
+  }
+
+  // The texture cache's copies of the EFB and the XFB.
+  g_texture_cache->ChimeraForEachCopy([&](TCacheEntry* entry) {
+    if (ChimeraWanted(entry) && ChimeraCarriable(entry->texture.get()))
+      add_texture(CHIMERA_CACHE_COPY, reinterpret_cast<u64>(entry), entry->texture.get());
+  });
+
+  // And the copies still waiting to be written to the machine's memory: their
+  // bytes are in a staging texture, which is the card's too.
+  g_texture_cache->ChimeraForEachPendingCopy([&](TCacheEntry* entry) {
+    const u64 row_bytes = u64(entry->pending_efb_copy_width) * 4;
+    const u64 bytes = row_bytes * entry->pending_efb_copy_height;
+    if (count == CHIMERA_SHADOW_MAX_RECORDS || bytes == 0 || bytes > ChimeraBandBytes() ||
+        end + bytes > ChimeraPixelBytes() || entry->pending_efb_copy->GetTexelSize() != 4)
+      return;
+    const MathUtil::Rectangle<int> rect(0, 0, int(entry->pending_efb_copy_width),
+                                        int(entry->pending_efb_copy_height));
+    entry->pending_efb_copy->ReadTexels(rect, ChimeraBand(), u32(row_bytes));
+    if (std::memcmp(pixels + end, ChimeraBand(), size_t(bytes)) != 0)
+      std::memcpy(pixels + end, ChimeraBand(), size_t(bytes));
+    ChimeraShadowRecord rec = {};
+    rec.owner = reinterpret_cast<u64>(entry);
+    rec.offset = end;
+    rec.bytes = bytes;
+    rec.kind = CHIMERA_PENDING_COPY;
+    rec.width = entry->pending_efb_copy_width;
+    rec.height = entry->pending_efb_copy_height;
+    fresh[count++] = rec;
+    end += bytes;
+  });
+
+  ChimeraShadowHeader header = {};
+  header.magic = CHIMERA_SHADOW_MAGIC;
+  header.count = count;
+  header.end = end;
+  if (std::memcmp(ChimeraHeader(), &header, sizeof(header)) != 0)
+    *ChimeraHeader() = header;
+  if (count != 0 &&
+      std::memcmp(ChimeraRecords(), fresh, count * sizeof(ChimeraShadowRecord)) != 0)
+    std::memcpy(ChimeraRecords(), fresh, count * sizeof(ChimeraShadowRecord));
+  if (!s_chimera_current)
+    s_chimera_current = true;
+}
+
+// chimera: the driver calls this at the head of every frame, before the machine
+// steps - nothing is mid-draw. The same decision the OpenGL backend makes
+// (chimera_dolphin_gl_frame_start, where every line of it is argued).
+extern "C" void chimera_dolphin_vk_frame_start(void)
+{
+  if (!(&chimera_dolphin_vulkan_context))
+    return;
+  const bool after_load = s_chimera_state_loaded;
+  s_chimera_state_loaded = false;
+  const uint64_t live = chimera_dolphin_vulkan_context();
+  if (live == 0)
+    return;
+
+  const bool usable = after_load && s_chimera_usable;
+  s_chimera_usable = false;
+
+  if (live != s_chimera_saved_context && (s_chimera_saved_context != 0 || after_load))
+  {
+    WARN_LOG_FMT(VIDEO,
+                 "chimera: these Vulkan objects came from another device ({}, now {}); rebuilding",
+                 s_chimera_saved_context, live);
+    static_cast<Vulkan::VKGfx*>(g_gfx.get())->ChimeraRebuild(usable);
+  }
+  s_chimera_saved_context = live;
+  if (s_chimera_current)
+    s_chimera_current = false;
+}
