+// chimera: the device, dropped and made again (VKGfx.cpp, ChimeraRebuild). A
+// savestate loaded into Chimera leaves the frontend with a new Vulkan device;
+// everything below the shared video code is let go of and made as Initialize()
+// makes it, without a window. The shared code's objects are the caller's to
+// let go of first, and to make again after.
+void ChimeraDropDevice()
+{
+  if (g_object_cache)
+    g_object_cache->Shutdown();
+  g_object_cache.reset();
+  StateTracker::DestroyInstance();
+  g_command_buffer_mgr.reset();
+  g_vulkan_context.reset();
+}
+
+bool ChimeraMakeDevice()
+{
+  u32 vk_api_version = 0;
+  VkInstance instance = VulkanContext::CreateVulkanInstance(WindowSystemType::Headless, false,
+                                                            false, &vk_api_version);
+  if (instance == VK_NULL_HANDLE)
+    return false;
+  if (!LoadVulkanInstanceFunctions(instance))
+  {
+    vkDestroyInstance(instance, nullptr);
+    return false;
+  }
+  VulkanContext::GPUList gpu_list = VulkanContext::EnumerateGPUs(instance);
+  if (gpu_list.empty())
+  {
+    vkDestroyInstance(instance, nullptr);
+    return false;
+  }
+  size_t adapter = static_cast<size_t>(g_Config.iAdapter);
+  if (adapter >= gpu_list.size())
+    adapter = 0;
+  g_vulkan_context = VulkanContext::Create(instance, gpu_list[adapter], VK_NULL_HANDLE, false,
+                                           false, vk_api_version);
+  if (!g_vulkan_context)
+    return false;
+  g_object_cache = std::make_unique<ObjectCache>();
+  if (!g_object_cache->Initialize())
+    return false;
+  g_command_buffer_mgr = std::make_unique<CommandBufferManager>(g_Config.bBackendMultithreading);
+  if (!g_command_buffer_mgr->Initialize(0))
+    return false;
+  return StateTracker::CreateInstance();
+}
