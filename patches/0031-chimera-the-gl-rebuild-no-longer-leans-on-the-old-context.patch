+// chimera: ChimeraClearAndForget() freed the formats, and the shader cache's
+// pipelines - made again from their uids right after - kept pointing at them:
+// a draw then bound whatever vertex array number the freed memory held, which
+// worked while Chimera kept the old GL context alive (the number was still a
+// vertex array there) and drew with the wrong one once every load was a fresh
+// context. So the formats stay, each makes its own array again, and the next
+// primitive looks its format up as after a clear.
+void ChimeraRemakeFormats(const std::function<void(NativeVertexFormat*)>& remake)
+{
+  {
+    std::lock_guard<std::mutex> lk(s_vertex_loader_map_lock);
+    for (auto& [decl, format] : s_native_vertex_map)
+      remake(format.get());
+  }
+  s_current_vtx_fmt = nullptr;
+  MarkAllDirty();
+}
