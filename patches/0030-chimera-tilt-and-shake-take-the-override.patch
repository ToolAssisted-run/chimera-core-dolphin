   return result;
 }
 
+Shake::StateData Shake::GetState(bool adjusted, const InputOverrideFunction& override_func) const
+{
+  StateData result = GetState(adjusted);
+  if (!override_func)
+    return result;
+  for (std::size_t i = 0; i != result.data.size(); ++i)
+  {
+    if (const std::optional<ControlState> v = override_func(name, controls[i]->name, result.data[i]))
+      result.data[i] = *v;
+  }
+  return result;
+}
+
