+// chimera: the stream buffers and texel views are persistent-mapped names a
+// gone context handed out; a savestate load lands them in a session that never
+// owned them, where mapping one hands back a dangling pointer. Drop them and
+// make them again on the live context. Safe to call between frames.
+void VertexManager::RecreateStreamBuffers()
+{
+  if (g_backend_info.bSupportsPaletteConversion)
+  {
+    glDeleteTextures(static_cast<GLsizei>(m_texel_buffer_views.size()),
+                     m_texel_buffer_views.data());
