+void ProgramShaderCache::ReacquireContextObjects()
+{
+  // The names below belong to a context that is gone; dropping them is a no-op
+  // on the driver (it never handed them out here) but the bookkeeping has to
+  // let go too. The linked programs are deliberately untouched: the pipelines
+  // that reference them are rebuilt elsewhere and release each through the map,
+  // so it stays consistent without being cleared here.
+  s_buffer.reset();
+  glBindVertexArray(0);
+  glDeleteBuffers(1, &s_attributeless_VBO);
+  glDeleteVertexArrays(1, &s_attributeless_VAO);
+  s_attributeless_VBO = 0;
+  s_attributeless_VAO = 0;
+  s_last_VAO = 0;
+  CurrentProgram = 0;
+
+  s_buffer = StreamBuffer::Create(GL_UNIFORM_BUFFER, VertexManagerBase::UNIFORM_STREAM_BUFFER_SIZE);
+  CreateAttributelessVAO();
+}
