+void OGLGfx::ChimeraRebuildGLObjects()
+{
+  // The teardown of a dead context's names leaves errors queued; the init paths
+  // below assert a clean slate, so drain first.
+  while (glGetError() != GL_NO_ERROR)
+  {
+  }
+
+  // Low-level objects that persistent-mapped buffers a frame writes through
+  // before any higher call: the uniform buffer + attributeless VAO, and the
+  // vertex manager's stream buffers. The program map is left intact - the
+  // pipelines that own its entries are rebuilt below and release each through
+  // it, so it stays balanced (Shutdown() would demand it already empty).
+  ProgramShaderCache::ReacquireContextObjects();
+  static_cast<VertexManager*>(g_vertex_manager.get())->RecreateStreamBuffers();
+
+  // The two shared framebuffers, the samplers, the bounding-box SSBO and the
+  // perf-query objects.
+  glDeleteFramebuffers(1, &m_shared_read_framebuffer);
+  glDeleteFramebuffers(1, &m_shared_draw_framebuffer);
+  glGenFramebuffers(1, &m_shared_read_framebuffer);
+  glGenFramebuffers(1, &m_shared_draw_framebuffer);
+  g_sampler_cache = std::make_unique<SamplerCache>();
+  static_cast<OGLBoundingBox*>(g_bounding_box.get())->Initialize();
+  g_perf_query = GetPerfQuery(IsGLES());
+
+  // Everything the higher layers cached named the gone context too. Drop it and
+  // rebuild what has to exist now; the rest comes back from emulated memory the
+  // next time a draw asks for it. Each rebuild below destroys its old pipelines
+  // (releasing their programs) and makes new ones on the live context, both
+  // through the map ReacquireContextObjects left untouched. The cached native
+  // vertex formats (per-format VAOs) are dropped so each is made again on
+  // demand.
+  VertexLoaderManager::Clear();
+  g_texture_cache->Invalidate();
+  g_texture_cache->ChimeraDropStagingTextures();
+  g_framebuffer_manager->RecreateEFBFramebuffer(g_ActiveConfig.iEFBScale);
+  g_framebuffer_manager->RecompileShaders();
+  g_shader_cache->Reload();
+
+  // Nothing the renderer thought was bound still is.
+  ProgramShaderCache::InvalidateVertexFormat();
+  m_current_pipeline = nullptr;
+
+  // ... but the current framebuffer may not be left NULL. The machine draws
+  // through BPFunctions::SetScissorAndViewport as soon as it runs again, and
+  // that asks the renderer for its current framebuffer and dereferences it
+  // without checking:
+  //
+  //   ConvertFramebufferRectangle(target_rc, g_gfx->GetCurrentFramebuffer())
+  //
+  // so a null here is a read of address 0x3c on the first frame after a
+  // savestate is loaded into a session that did not make it - which is exactly
+  // when this function runs. Clear it and then bind the EFB, which is where a
+  // frame starts anyway and which RecreateEFBFramebuffer has just remade; the
+  // clear first is what stops SetFramebuffer taking it for a no-op.
+  m_current_framebuffer = nullptr;
+  g_framebuffer_manager->BindEFBFramebuffer();
+  m_current_rasterization_state = RenderState::GetInvalidRasterizationState();
+  m_current_depth_state = RenderState::GetInvalidDepthState();
+  m_current_blend_state = RenderState::GetInvalidBlendingState();
+  m_bound_textures.fill(nullptr);
+
+  while (glGetError() != GL_NO_ERROR)
+  {
+  }
+}
+
 }  // namespace OGL
+
+// chimera: which context the GL calls are landing on (miniBox source/gl:
+// GL_OP_CONTEXT_ID). Weak, so a build with no bridge links null here.
+extern "C" uint64_t chimera_gl_context_id(void) __attribute__((weak));
+
+// chimera: the driver calls this at the head of every frame, before the machine
+// steps. The GL objects the OGL backend holds are names that live in emulated
+// memory; a savestate load into a later session leaves them belonging to a
+// context that is gone. Comparing the context the calls are landing on with the
+// one they came from is the only way to notice - and here, between frames, is
+// the one place nothing is mid-draw and no resource is on the stack, so the
+// whole backend can be rebuilt at once, covering every path (texture cache,
+// framebuffer manager, presenter) that issues GL without passing through a
+// backend setter. A no-op when there is no bridge, or the software renderer is
+// in use (g_gfx is not an OGLGfx then - the driver only calls this for OGL).
+extern "C" void chimera_dolphin_gl_frame_start(void)
+{
+  if (!(&chimera_gl_context_id))
+    return;
+  const uint64_t live = chimera_gl_context_id();
+  // 0 is "cannot tell" - no bridge, or a host older than the question - and a
+  // renderer that cannot tell must assume the ground has not moved.
+  if (live == 0)
+    return;
+
+  // The remembered context lives in emulated memory, so a savestate restores it
+  // like everything else: on a fresh load it holds the save session's id, which
+  // differs from the one now live.
+  static uint64_t s_saved_context = 0;
+  if (s_saved_context != 0 && live != s_saved_context)
+  {
+    if (OGL::OGLGfx* gfx = OGL::GetOGLGfx())
+    {
+      WARN_LOG_FMT(VIDEO,
+                   "chimera: these GL objects came from another context ({}, now {}); rebuilding",
+                   s_saved_context, live);
+      gfx->ChimeraRebuildGLObjects();
+    }
+  }
+  s_saved_context = live;
+}
