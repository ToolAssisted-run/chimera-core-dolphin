@@ -5,16 +5,31 @@
 
 using namespace ciface::ExpressionParser;
 
+#ifdef CHIMERA_NO_TLS
+// No ELF TLS in the sandbox. The key's zero default must mean the gate's
+// default, which is OPEN - so the stored bit is "gate closed".
+#include "Common/SandboxTls.h"
+static Common::SandboxTlsValue<bool> tls_input_gate_closed;
+#else
 static thread_local bool tls_input_gate = true;
+#endif
 
 void ControlReference::SetInputGate(bool enable)
 {
+#ifdef CHIMERA_NO_TLS
+  tls_input_gate_closed = !enable;
+#else
   tls_input_gate = enable;
+#endif
 }
 
 bool ControlReference::GetInputGate()
 {
+#ifdef CHIMERA_NO_TLS
+  return !tls_input_gate_closed;
+#else
   return tls_input_gate;
+#endif
 }
 
