@@ -18,8 +20,16 @@ public:
   {
     mbedtls_entropy_init(&m_entropy);
     mbedtls_hmac_drbg_init(&m_context);
+#ifdef CHIMERA_NO_TLS
+    // The sandbox has no entropy source, and a reproducible machine would
+    // not want one: a fixed seed makes every draw part of the recording.
+    static constexpr u8 seed[] = "chimera-fixed-prng-seed";
+    const int ret = mbedtls_hmac_drbg_seed_buf(
+        &m_context, mbedtls_md_info_from_type(MBEDTLS_MD_SHA256), seed, sizeof(seed));
+#else
     const int ret = mbedtls_hmac_drbg_seed(&m_context, mbedtls_md_info_from_type(MBEDTLS_MD_SHA256),
                                            mbedtls_entropy_func, &m_entropy, nullptr, 0);
+#endif
     ASSERT(ret == 0);
   }
 
@@ -40,10 +50,22 @@ private:
   mbedtls_hmac_drbg_context m_context;
 };
 
+#ifdef CHIMERA_NO_TLS
+// No ELF TLS in the sandbox: one PRNG behind a lock serves every thread.
+static EntropySeededPRNG s_esprng;
+static std::mutex s_esprng_lock;
+
+void Generate(void* buffer, std::size_t size)
+{
+  std::lock_guard lock(s_esprng_lock);
+  s_esprng.Generate(buffer, size);
+}
+#else
 static thread_local EntropySeededPRNG s_esprng;
 
 void Generate(void* buffer, std::size_t size)
 {
   s_esprng.Generate(buffer, size);
 }
+#endif
 }  // namespace Common::Random
