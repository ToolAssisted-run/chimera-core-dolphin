--- a/Source/Core/Core/MemTools.cpp
+++ b/Source/Core/Core/MemTools.cpp
@@ -117,7 +117,14 @@ void UninstallExceptionHandler()
 
 bool IsExceptionHandlerSupported()
 {
+#ifdef DOLPHIN_NO_FAULT_OPTIMIZATIONS
+  // Fault-driven optimizations (fastmem, the BLR return stack) are a build
+  // option; without them nothing ever faults on purpose and no handler is
+  // wanted - including on hosts that have no signal machinery at all.
+  return false;
+#else
   return true;
+#endif
 }
 
 #elif defined(__APPLE__) && !defined(USE_SIGACTION_ON_APPLE)
@@ -253,7 +260,14 @@ void UninstallExceptionHandler()
 
