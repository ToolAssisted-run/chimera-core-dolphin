diff --git a/Source/Core/Core/Core.cpp b/Source/Core/Core/Core.cpp
index 8ce66e67bb..1efdf2af70 100644
--- a/Source/Core/Core/Core.cpp
+++ b/Source/Core/Core/Core.cpp
@@ -333,7 +341,12 @@ static void CpuThread(Core::System& system, const std::optional<std::string>& sa
   system.GetPerfMetrics().Reset();
 
   // The JIT need to be able to intercept faults, both for fastmem and for the BLR optimization.
-  const bool exception_handler = EMM::IsExceptionHandlerSupported();
+  // The interpreters never fault on purpose - and a host without signal
+  // machinery (the sandbox) can boot them without any handler at all.
+  const PowerPC::CPUCore cpu_core = Config::Get(Config::MAIN_CPU_CORE);
+  const bool wants_fault_interception =
+      cpu_core != PowerPC::CPUCore::Interpreter && cpu_core != PowerPC::CPUCore::CachedInterpreter;
+  const bool exception_handler = wants_fault_interception && EMM::IsExceptionHandlerSupported();
   if (exception_handler)
     EMM::InstallExceptionHandler();
 

