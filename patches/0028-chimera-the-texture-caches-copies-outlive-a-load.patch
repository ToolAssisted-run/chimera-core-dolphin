+void TextureCacheBase::ChimeraForEachCopy(const std::function<void(TCacheEntry*)>& f)
+{
+  for (auto& [address, entry] : m_textures_by_address)
+  {
+    if (entry->IsCopy() && entry->texture)
+      f(entry.get());
+  }
+}
+
+void TextureCacheBase::ChimeraForEachPendingCopy(const std::function<void(TCacheEntry*)>& f)
+{
+  for (auto& entry : m_pending_efb_copies)
+  {
+    if (entry->pending_efb_copy)
+      f(entry.get());
+  }
+}
+
+void TextureCacheBase::ChimeraLetGo(const std::function<bool(TCacheEntry*)>& keep_texture,
+                                    const std::function<bool(TCacheEntry*)>& keep_pending)
+{
+  TMEM::InvalidateAll();
+  for (auto& bind : m_bound_textures)
+    bind.reset();
+
+  // A copy that was waiting to be written to RAM stays waiting if its bytes
+  // were carried; one whose bytes were not is forgotten, which loses them - as
+  // flushing a dead staging texture did, without writing anything in their
+  // place.
+  for (auto it = m_pending_efb_copies.begin(); it != m_pending_efb_copies.end();)
+  {
+    TCacheEntry* const entry = it->get();
+    entry->pending_efb_copy.reset();
+    entry->chimera_pending_bytes.clear();
+    if (keep_pending && keep_pending(entry))
+      ++it;
+    else
+      it = m_pending_efb_copies.erase(it);
+  }
+
+  m_textures_by_hash.clear();
+  for (auto it = m_textures_by_address.begin(); it != m_textures_by_address.end();)
+  {
+    TCacheEntry* const entry = it->second.get();
+    entry->textures_by_hash_iter = m_textures_by_hash.end();
+    const bool keep = entry->IsCopy() && entry->texture && keep_texture && keep_texture(entry);
+    // dropped here and not left to the destructor, which would hand a texture
+    // of the dead context to the pool for the next allocation to find
+    entry->framebuffer.reset();
+    entry->texture.reset();
+    if (keep)
+    {
+      ++it;
+    }
+    else
+    {
+      entry->invalidated = true;
+      it = m_textures_by_address.erase(it);
+    }
+  }
+
+  m_texture_pool.clear();
+  m_efb_copy_staging_texture_pool.clear();
+  m_readback_texture.reset();
+}
+
+bool TextureCacheBase::ChimeraReseat(TCacheEntry* entry, const TextureConfig& config)
+{
+  std::optional<TexPoolEntry> alloc = AllocateTexture(config);
+  if (!alloc)
+    return false;
+  entry->texture = std::move(alloc->texture);
+  entry->framebuffer = std::move(alloc->framebuffer);
+  return true;
+}
+
+bool TextureCacheBase::ChimeraReseatPending(TCacheEntry* entry, const u8* bytes, size_t size)
+{
+  // a stand-in, so that everything asking "is a copy pending?" gets the answer
+  // it got before the load; FlushEFBCopy writes the bytes and not what it holds
+  entry->pending_efb_copy = GetEFBCopyStagingTexture();
+  if (!entry->pending_efb_copy)
+    return false;
+  entry->chimera_pending_bytes.assign(bytes, bytes + size);
+  return true;
+}
+
+void TextureCacheBase::ChimeraDrop(TCacheEntry* entry)
+{
+  for (auto it = m_pending_efb_copies.begin(); it != m_pending_efb_copies.end();)
+  {
+    if (it->get() == entry && !entry->pending_efb_copy)
+      it = m_pending_efb_copies.erase(it);
+    else
+      ++it;
+  }
+  auto [it, end] = m_textures_by_address.equal_range(entry->addr);
+  for (; it != end; ++it)
+  {
+    if (it->second.get() == entry)
+    {
+      entry->invalidated = true;
+      m_textures_by_address.erase(it);
+      return;
+    }
+  }
+}
